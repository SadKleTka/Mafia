@{
    ViewData["Title"] = "Войти — Мафия онлайн";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/main-menu.css">
</head>
<body>
<div class="auth-page">
    <div class="auth-logo">Мафия онлайн</div>

    <div class="auth-card">
        <h2>Вход в аккаунт</h2>

        <div class="field">
            <label for="login">Логин или Email</label>
            <input id="login" class="input" type="text" placeholder="username / email" autocomplete="username">
        </div>

        <div class="field">
            <label for="password">Пароль</label>
            <input id="password" class="input" type="password" placeholder="••••••••" autocomplete="current-password">
        </div>

        <button id="submit-btn" class="btn btn-primary btn-full" onclick="doLogin()">Войти</button>

        <div id="alert" class="alert"></div>
    </div>

    <div class="auth-footer">
        Нет аккаунта? <a href="/AuthRegister/Home/Index">Зарегистрироваться</a>
    </div>
</div>

<script>
    // Redirect if already logged in
    if (localStorage.getItem('jwt')) {
        window.location.href = '/MainMenu/Home/Index';
    }

    function showAlert(msg, type) {
        const el = document.getElementById('alert');
        el.textContent = msg;
        el.className = 'alert alert-' + type + ' show';
    }

    async function doLogin() {
        const login    = document.getElementById('login').value.trim();
        const password = document.getElementById('password').value;
        const btn      = document.getElementById('submit-btn');

        if (!login || !password) {
            showAlert('Заполните все поля.', 'error');
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Вход...';

        try {
            const res = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ login, password })
            });

            const data = await res.json();

            if (data.state === true) {
                localStorage.setItem('jwt', data.message);
                window.location.href = '/MainMenu/Home/Index';
            } else {
                showAlert(data.message || 'Неверный логин или пароль.', 'error');
                btn.disabled = false;
                btn.textContent = 'Войти';
            }
        } catch (err) {
            showAlert('Ошибка сети. Проверьте соединение.', 'error');
            btn.disabled = false;
            btn.textContent = 'Войти';
        }
    }

    document.addEventListener('keydown', e => {
        if (e.key === 'Enter') doLogin();
    });
</script>
</body>
</html>
